MNEME_ENVIRONMENT=development
MNEME_DEBUG=false
MNEME_LOG_LEVEL=INFO
MNEME_READINESS_TIMEOUT_SECONDS=2
MNEME_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mneme
MNEME_REDIS_URL=redis://localhost:6379/0
MNEME_REDIS_MAX_CONNECTIONS=10
MNEME_REDIS_SOCKET_TIMEOUT_SECONDS=5
MNEME_ARQ_QUEUE_NAME=mneme:jobs
MNEME_ARQ_MAX_JOBS=5
MNEME_ARQ_JOB_TIMEOUT_SECONDS=300
MNEME_ARQ_MAX_TRIES=3
MNEME_ARQ_HEALTH_CHECK_INTERVAL_SECONDS=30
MNEME_ARXIV_API_URL=https://export.arxiv.org/api/query
MNEME_ARXIV_USER_AGENT=Mneme/0.1 (+https://github.com/YUcxovo/MNEME)
MNEME_ARXIV_REQUEST_INTERVAL_SECONDS=3
MNEME_ARXIV_TIMEOUT_SECONDS=30
MNEME_ARXIV_MAX_ATTEMPTS=3
MNEME_ARXIV_MAX_RESULTS=100
MNEME_ARXIV_DAILY_CATEGORIES=cs.AI,cs.LG
MNEME_ARXIV_DAILY_MAX_RESULTS=20
MNEME_SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
# Request a project key for a stable individual rate limit; never commit it.
# MNEME_SEMANTIC_SCHOLAR_API_KEY=<semantic-scholar-api-key>
MNEME_SEMANTIC_SCHOLAR_REQUEST_INTERVAL_SECONDS=1
MNEME_SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=30
MNEME_SEMANTIC_SCHOLAR_MAX_ATTEMPTS=3
MNEME_SEMANTIC_SCHOLAR_BATCH_SIZE=100
MNEME_SEMANTIC_SCHOLAR_PAGE_SIZE=100
MNEME_SEMANTIC_SCHOLAR_MAX_NEIGHBORS=1000
MNEME_PAPER_STORAGE_DIR=.data/papers
MNEME_PDF_MAX_BYTES=52428800
MNEME_PDF_DOWNLOAD_TIMEOUT_SECONDS=60
MNEME_PDF_DOWNLOAD_MAX_ATTEMPTS=3
MNEME_PDF_MIN_TEXT_CHARS=500
# Protected endpoints also require both settings below. Generate the digest with
# `uv run python -m mneme.cli.hash_demo_token`, then uncomment and replace both values.
# MNEME_DEMO_TOKEN_SHA256=<64-character-sha256-hex-digest>
# MNEME_DEMO_USER_ID=<uuid>
# AI services need at least one provider key; keep raw keys outside git.
# MNEME_ANTHROPIC_API_KEY=<anthropic-api-key>
# MNEME_DEEPSEEK_API_KEY=<deepseek-api-key>
# MNEME_OPENAI_API_KEY=<openai-api-key>
MNEME_DEEPSEEK_THINKING_ENABLED=false
MNEME_LLM_TIMEOUT_SECONDS=60
MNEME_LLM_SUMMARY_MODEL=claude-opus-4-8
MNEME_LLM_QA_MODEL=claude-opus-4-8
MNEME_AI_DAILY_BUDGET_USD=5
MNEME_AI_CACHE_ENABLED=true
MNEME_AI_SUMMARY_CACHE_TTL_SECONDS=604800
MNEME_AI_QA_CACHE_TTL_SECONDS=86400
MNEME_AI_EMBEDDING_BACKEND=openai
MNEME_AI_EMBEDDING_MODEL=text-embedding-3-small
MNEME_AI_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
