[Unit]
Description=Apply Mneme database migrations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=${service_user}
Group=${service_group}
WorkingDirectory=${install_dir}/backend
EnvironmentFile=${environment_file}
ExecStart=${install_dir}/backend/.venv/bin/alembic upgrade head
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0027
