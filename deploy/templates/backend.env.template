# Rendered deployment configuration. Replace every <...> value before preflight.
MNEME_ENVIRONMENT=production
MNEME_DEBUG=false
MNEME_LOG_LEVEL=INFO
MNEME_API_HOST=${api_host}
MNEME_API_PORT=${api_port}
MNEME_API_WORKERS=${api_workers}
MNEME_API_TIMEOUT_SECONDS=120
MNEME_API_GRACEFUL_TIMEOUT_SECONDS=90
MNEME_API_KEEPALIVE_SECONDS=5
MNEME_API_MAX_REQUESTS=1000
MNEME_API_MAX_REQUESTS_JITTER=100
MNEME_DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@127.0.0.1:5432/mneme
MNEME_REDIS_URL=redis://127.0.0.1:6379/0
MNEME_PAPER_STORAGE_DIR=${paper_data_dir}
MNEME_DEMO_TOKEN_SHA256=<demo-token-sha256>
MNEME_DEMO_USER_ID=<demo-user-uuid>

# Provider and model selection belongs to the AI owner. Set at least one provider
# key and replace both model identifiers before enabling AI-backed demo paths.
# MNEME_ANTHROPIC_API_KEY=<anthropic-api-key>
# MNEME_DEEPSEEK_API_KEY=<deepseek-api-key>
# MNEME_OPENAI_API_KEY=<openai-api-key>
MNEME_LLM_SUMMARY_MODEL=<validated-summary-model-id>
MNEME_LLM_QA_MODEL=<validated-qa-model-id>
MNEME_AI_EMBEDDING_MODEL=<validated-embedding-model-id>

# Optional Semantic Scholar project key for a stable individual rate limit.
# MNEME_SEMANTIC_SCHOLAR_API_KEY=<semantic-scholar-api-key>

# Read by UvicornWorker. Nginx is the only trusted forwarding peer.
FORWARDED_ALLOW_IPS=127.0.0.1

# Public acceptance target. The Q&A step remains opt-in until the AI owner has
# validated the production provider/model pair and supplied a demo question.
MNEME_MVP_SMOKE_BASE_URL=https://${server_name}
MNEME_MVP_SMOKE_SEED=1706.03762
# Copy seed_paper_id from the successful seed result to avoid a bounded catalog scan.
# MNEME_MVP_SMOKE_PAPER_ID=<seed-paper-uuid>
# MNEME_MVP_SMOKE_QUESTION=<validated-demo-question>
